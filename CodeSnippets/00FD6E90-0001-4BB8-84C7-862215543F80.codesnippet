<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string></string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>TopLevel</string>
		<string>ClassImplementation</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>/// Coding Keys
/// https://developer.apple.com/documentation/foundation/encoding-and-decoding-custom-types
extension &lt;#ModelName#&gt; {
    enum CodingKeys: String, CodingKey {
        case &lt;#nameKey#&gt; = "title"
        case &lt;#descriptionKey#&gt; = "desc"
        case &lt;#nestedDataKey#&gt;
    }

    enum &lt;#NestedInfoKeys#&gt;: String, CodingKey {
        case &lt;#nestedNameKey#&gt; = "title"
        case &lt;#nestedDescriptionKey#&gt; = "desc"
    }
}
</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>00FD6E90-0001-4BB8-84C7-862215543F80</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>Creates a CodingKeys template</string>
	<key>IDECodeSnippetTitle</key>
	<string>CodingKeys Snippet</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
