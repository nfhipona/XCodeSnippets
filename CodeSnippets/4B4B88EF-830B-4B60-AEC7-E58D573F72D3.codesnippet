<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IDECodeSnippetCompletionPrefix</key>
	<string></string>
	<key>IDECodeSnippetCompletionScopes</key>
	<array>
		<string>TopLevel</string>
	</array>
	<key>IDECodeSnippetContents</key>
	<string>/// Nested Encodable Conformance
/// https://developer.apple.com/documentation/foundation/encoding-and-decoding-custom-types
extension &lt;#ModelName#&gt;: Encodable {
    func encode(to encoder: Encoder) throws {
        var container = encoder.container(keyedBy: CodingKeys.self)
        try container.encode(&lt;#nameProperty#&gt;, forKey: .&lt;#nameProperty#&gt;)
        try container.encode(&lt;#descriptionProperty#&gt;, forKey: .&lt;#descriptionProperty#&gt;)

        var &lt;#nestedContainer#&gt; = container.nestedContainer(keyedBy: &lt;#NestedInfoKeys#&gt;.self, forKey: .&lt;#nestedDataKey#&gt;)
        try &lt;#nestedContainer#&gt;.encode(&lt;#nestedNameKey#&gt;, forKey: .&lt;#nestedNameKey#&gt;)
        try &lt;#nestedContainer#&gt;.encode(&lt;#nestedDescriptionKey#&gt;, forKey: .&lt;#nestedDescriptionKey#&gt;)
    }
}</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>4B4B88EF-830B-4B60-AEC7-E58D573F72D3</string>
	<key>IDECodeSnippetLanguage</key>
	<string>Xcode.SourceCodeLanguage.Swift</string>
	<key>IDECodeSnippetSummary</key>
	<string>Creates a nested Encodable template. This moves top level properties to nested properties.</string>
	<key>IDECodeSnippetTitle</key>
	<string>Nested Encodable Snippet</string>
	<key>IDECodeSnippetUserSnippet</key>
	<true/>
	<key>IDECodeSnippetVersion</key>
	<integer>2</integer>
</dict>
</plist>
